#ifndef __VERSION_H
#define __VERSION_H

#include <cstdint>

#ifdef QT_VERSION
    #include <QString>
    #include <QDateTime>
    #include <QApplication>
    #include <QTimeZone>
    #include <QLocale>
    // #include <QDebug>
#else
    #include <string>
#endif

namespace NVersion
{
#ifdef QT_VERSION
    using TStringType = QString;

    inline bool isEmpty( const TStringType &value )
    {
        return value.isEmpty();
    }

    template< typename T >
    TStringType toString( T value )
    {
        return QString::number( value );
    }
#else
    using TStringType = std::string;

    inline bool isEmpty( const TStringType &value )
    {
        return value.empty();
    }

    template< typename T >
    TStringType toString( T value )
    {
        return std::to_string( value );
    }
#endif

    inline const int MAJOR_VERSION = @VERSION_FILE_MAJOR_VERSION@;
    inline const int MINOR_VERSION = @VERSION_FILE_MINOR_VERSION@;
    inline const TStringType PATCH_VERSION = "@VERSION_FILE_PATCH_VERSION@";   // string from git
    inline const uint16_t PATCH_VERSION_LOW = @VERSION_FILE_PATCH_VERSION_HIGH@;   // string from git
    inline const uint16_t PATCH_VERSION_HIGH = @VERSION_FILE_PATCH_VERSION_LOW@;   // string from git

    inline const bool MODIFIED = @VERSION_FILE_DIFF@;
    inline const TStringType APP_NAME = "@VERSION_FILE_APP_NAME@";
    inline const TStringType VENDOR = "@VERSION_FILE_VENDOR@";
    inline const TStringType HOMEPAGE = "@VERSION_FILE_HOMEPAGE@";
    inline const TStringType PRODUCT_HOMEPAGE = "@VERSION_FILE_PRODUCT_HOMEPAGE@";
    inline const TStringType EMAIL = "@VERSION_FILE_EMAIL@";
    inline const TStringType COPYRIGHT = "@VERSION_FILE_COPYRIGHT@";
    inline const TStringType BUILD_DATE_UTC = TStringType( "@VERSION_FILE_BUILD_DATE@" );
    inline const TStringType BUILD_TIME_UTC = TStringType( "@VERSION_FILE_BUILD_TIME@" );

#ifdef QT_VERSION
    inline QDateTime buildDateTime( bool localTime )
    {
        if ( isEmpty( BUILD_DATE_UTC ) || isEmpty( BUILD_TIME_UTC ) )
            return {};

        auto retVal = QDateTime::fromString( BUILD_DATE_UTC + " " + BUILD_TIME_UTC, "MM/dd/yyyy HH:mm:sst" );
        Q_ASSERT( retVal.isValid() );
        //qDebug() << retVal;
        retVal.setTimeSpec( Qt::TimeSpec::UTC );
        //qDebug() << retVal;
        if ( localTime )
        {
            retVal = retVal.toLocalTime();
        }
        //qDebug() << retVal;
           
        return retVal;
    }
#endif

    inline TStringType getVersionString( bool localTime, bool full )
    {
        auto retVal = toString( MAJOR_VERSION ) + ".";
#ifdef VERSION_FILE_FORCE_TWODIGITS_MINOR
        if ( MINOR_VERSION < 10 )
            retVal += '0';
#endif
        retVal += toString( MINOR_VERSION );
        if ( full )
            retVal += "." + PATCH_VERSION;
        if ( MODIFIED )
            retVal += "*";
        auto buildDateTime = NVersion::buildDateTime( localTime );
        if ( buildDateTime.isValid() )
        {
            retVal += " Build Date: " + buildDateTime.toString( "MM/dd/yyyy hh:mm:ss" );

            auto abbr = buildDateTime.timeZoneAbbreviation();
            if ( !abbr.isEmpty() )
            {
                auto tzString = abbr;
                if ( abbr.startsWith( "Pacific", Qt::CaseInsensitive ) || abbr.startsWith( "Mountain", Qt::CaseInsensitive ) || abbr.startsWith( "Central", Qt::CaseInsensitive ) || abbr.startsWith( "Eastern", Qt::CaseInsensitive ) )
                {
                    tzString = abbr.front().toUpper();
                    if ( buildDateTime.isDaylightTime() )
                        tzString += "DT";
                    else
                        tzString += "ST";
                }
                retVal += " " +  tzString;
            }
        }
        return retVal;
    }

    inline TStringType getWindowTitle()
    {
        auto retVal = APP_NAME + " v" + getVersionString( true, true ) + " - https://" + HOMEPAGE;
        return retVal;
    }

#ifdef QT_VERSION
    inline void setupApplication( QCoreApplication &appl, bool useProductHomepage )
    {
        appl.setApplicationName( APP_NAME );
        appl.setApplicationVersion( getVersionString( false, true ) );
        appl.setOrganizationName( VENDOR );
        appl.setOrganizationDomain( useProductHomepage ? PRODUCT_HOMEPAGE : HOMEPAGE );
    }
#endif
}

#endif
